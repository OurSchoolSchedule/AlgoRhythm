# 개발·배포 공통: 브라우저에서 같은 origin의 /api로 요청
VITE_API_BASE_URL=
# Vite 개발 서버의 전달 대상. 로컬 백엔드 사용 시 http://localhost:8080
API_PROXY_TARGET=https://edu.rssolplan.com

# 배포(Vercel): frontend/.env.production 참고 — VITE_API_BASE_URL 비움 + vercel.json 프록시
# Vercel 대시보드에 VITE_API_BASE_URL=https://edu.rssolplan.com 가 있으면 제거하거나 비워 두세요.
